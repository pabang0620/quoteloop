# QuoteLoop runs as three processes. Nothing below is required: with no PayPal keys the flow runs
# against the bundled mock PayPal process (same REST paths and response shapes), and with no
# ANTHROPIC_API_KEY the agents run in policy mode (code rules only).

# --- Shared ---
FORCE_MOCK=0                       # 1 = never use real PayPal or Claude keys, even if set
ANTHROPIC_API_KEY=                 # optional, enables "Claude" agent mode on both services
ANTHROPIC_MODEL=claude-sonnet-5-5
LLM_BACKEND=                       # "account" = run the model through your own Claude Code login (local use, never an API key)

# --- Mock PayPal process (:4103) ---
MOCK_PAYPAL_PORT=4103
MOCK_PAYPAL_URL=http://localhost:4103
MOCK_TXN_LAG_MS=120000             # delay before a charge shows in the mock's Transaction Search (2 minutes so the demo path finishes; PayPal documents up to 3 hours)
MOCK_PAYER_SEES_CUSTOM_FIELD=1     # 0 = payer-side search hides the supplier's custom_id (audit falls back to amount and time)
MOCK_REFUND_PENDING=0              # 1 = refunds stay PENDING like some sandbox reports

# --- Supplier service (:4102), Northbeam Supply ---
SUPPLIER_PORT=4102
SUPPLIER_PUBLIC_URL=http://localhost:4102
SUPPLIER_UI_RETURN_URL=http://localhost:4101   # where the browser lands after saving PayPal
SUPPLIER_DB_FILE=data/supplier.db
SUPPLIER_KEY_FILE=data/supplier.key            # Ed25519 key, created on first start
SUPPLIER_SIGNING_KEY=                          # or a PKCS8 PEM (use \n for newlines)
SUPPLIER_PAYPAL_CLIENT_ID=                     # sandbox REST app of the supplier's business account
SUPPLIER_PAYPAL_CLIENT_SECRET=
SUPPLIER_PRESET_VAULT_ID=                      # optional: a payment token already saved by the operator
SUPPLIER_PRESET_VAULT_PAYER_EMAIL=             # payer email of that token (marks the judge account)
SUPPLIER_JUDGE_PAYER_EMAILS=judge-buyer@brightcup.example
SUPPLIER_PER_CHARGE_LIMIT_CENTS=150000
SUPPLIER_QUOTE_TTL_MS=900000
SUPPLIER_PAYPAL_WEBHOOK_ID=                     # webhook id from the PayPal dashboard (INVOICING.INVOICE.PAID); the mock needs none
SUPPLIER_ADMIN_TOKEN=                          # enables /admin/* (judge balance, health check, run refunds)
PAYPAL_VAULT_USAGE_PATTERN=UNSCHEDULED_POSTPAID
PAYPAL_VAULT_CUSTOMER_TYPE=CONSUMER
PAYPAL_STORED_CREDENTIAL=0                     # 1 = add stored_credential (MERCHANT / SUBSEQUENT) to vault orders
# Judge-period guards
JUDGE_REFUND_DELAY_MS=                         # empty = refund a judge-account charge after 10 minutes on the sandbox, 2 minutes on the bundled mock
JUDGE_STARTING_BALANCE_CENTS=1000000
JUDGE_MIN_BALANCE_CENTS=150000
LIVE_CHARGES_PER_CLIENT_PER_DAY=3
LIVE_CHARGES_PER_DAY=60

# --- Buyer service (:4101), Brightcup Cafes ---
BUYER_PORT=4101
BUYER_PUBLIC_URL=http://localhost:4101
BUYER_SUPPLIER_URL=http://localhost:4102       # how the buyer service reaches the supplier
BUYER_SUPPLIER_PUBLIC_URL=http://localhost:4102 # how the browser reaches the supplier (read-only screens)
BUYER_SUPPLIER_KID_PIN=                        # optional: refuse a supplier whose key id differs
BUYER_ADMIN_TOKEN=                             # enables POST /admin/daily-check and /admin/reset-demo
BUYER_DB_FILE=data/buyer.db
BUYER_KEY_FILE=data/buyer.key
BUYER_SIGNING_KEY=
BUYER_PAYPAL_CLIENT_ID=                        # sandbox REST app of the procurement account (needs Transaction Search)
BUYER_PAYPAL_CLIENT_SECRET=
BUYER_ACTIVITY_SIDE=payer                      # payer = buyer app owns the paying account; payee = sandbox demo sharing the supplier's REST app
BUYER_MOCK_ACCOUNT=judge                       # judge | procurement (which mock payer account the buyer reads)
BUYER_STATIC_DIR=dist
CLAUDE_RUNS_PER_CLIENT_PER_DAY=5                # model-mode deals per visitor per UTC day, then policy mode
CLAUDE_RUNS_PER_DAY=100
LLM_LIVE_UNTIL=2026-12-22T00:00:00+09:00        # after this the model is never called
BUYER_SEED_HISTORY=1                           # mock mode: seed yesterday's deal Q-0041 (matched, refunded)
